{
  "name": "sloy",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "native:prepare": "node scripts/build-native.mjs",
    "native:dev": "tauri dev",
    "native:build": "tauri build",
    "android:init": "tauri android init && node scripts/prepare-android.mjs",
    "android:debug": "tauri android build --debug --target aarch64 --apk --ci",
    "android:release": "tauri android build --target aarch64 --apk --ci",
    "test:native": "npm run native:prepare && node --test native/tests/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/core/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "esbuild": "^0.25.0",
    "yaml": "^2.8.0"
  }
}
