pkgname=sloy
pkgver=0.1.0
pkgrel=2
pkgdesc='Journal, tasks and habits over an Obsidian Markdown vault'
arch=('x86_64')
license=('custom')
depends=('webkit2gtk-4.1' 'gtk3' 'librsvg' 'openssl' 'gcc-libs')
makedepends=('rust' 'nodejs' 'npm')
# GCC LTO objects from bundled ring/SQLite cannot be linked by Rust's lld.
# Ship one installable package rather than a separate debug package.
options=('!lto' '!debug')
# Put Sloy-source.zip next to this file. This recipe builds locally; it is not an AUR submission.
source=('Sloy-source.zip')
sha256sums=('SKIP')
build() {
  cd "$srcdir/Sloy-source"
  npm ci
  npm run native:build -- --no-bundle
}
package() {
  cd "$srcdir/Sloy-source"
  install -Dm755 src-tauri/target/release/sloy "$pkgdir/usr/bin/sloy"
  local size icons="$pkgdir/usr/share/icons/hicolor"
  for size in 32x32 64x64 128x128; do
    install -Dm644 "src-tauri/icons/$size.png" "$icons/$size/apps/sloy.png"
  done
  install -Dm644 src-tauri/icons/128x128@2x.png "$icons/256x256/apps/sloy.png"
  install -Dm644 src-tauri/icons/icon.png "$icons/512x512/apps/sloy.png"
  # GTK uses the executable name as the Wayland app_id.
  install -Dm644 packaging/arch/sloy.desktop "$pkgdir/usr/share/applications/sloy.desktop"
}
